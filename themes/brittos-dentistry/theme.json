{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": false,
      "customGradient": false,
      "palette": [
        {
          "slug": "ink",
          "color": "#171817",
          "name": "Ink"
        },
        {
          "slug": "ink-deep",
          "color": "#0D1110",
          "name": "Ink Deep"
        },
        {
          "slug": "porcelain",
          "color": "#F7F5F0",
          "name": "Porcelain"
        },
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White"
        },
        {
          "slug": "champagne",
          "color": "#C8A77B",
          "name": "Champagne"
        },
        {
          "slug": "champagne-soft",
          "color": "#E8DDCB",
          "name": "Champagne Soft"
        },
        {
          "slug": "sage",
          "color": "#7F9287",
          "name": "Sage"
        },
        {
          "slug": "sage-soft",
          "color": "#E7ECE8",
          "name": "Sage Soft"
        },
        {
          "slug": "muted",
          "color": "#737873",
          "name": "Muted"
        },
        {
          "slug": "border",
          "color": "#DEDCD5",
          "name": "Border"
        }
      ],
      "link": true
    },
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1280px"
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "1",
          "size": "4px",
          "name": "XS"
        },
        {
          "slug": "2",
          "size": "8px",
          "name": "S"
        },
        {
          "slug": "3",
          "size": "12px",
          "name": "SM"
        },
        {
          "slug": "4",
          "size": "16px",
          "name": "M"
        },
        {
          "slug": "5",
          "size": "24px",
          "name": "L"
        },
        {
          "slug": "6",
          "size": "32px",
          "name": "XL"
        },
        {
          "slug": "7",
          "size": "48px",
          "name": "2XL"
        },
        {
          "slug": "8",
          "size": "64px",
          "name": "3XL"
        },
        {
          "slug": "9",
          "size": "96px",
          "name": "4XL"
        },
        {
          "slug": "10",
          "size": "128px",
          "name": "5XL"
        },
        {
          "slug": "11",
          "size": "160px",
          "name": "6XL"
        }
      ],
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "instrument-sans",
          "name": "Instrument Sans",
          "fontFamily": "\"Instrument Sans\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        },
        {
          "slug": "dm-sans",
          "name": "DM Sans",
          "fontFamily": "\"DM Sans\", system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        }
      ],
      "fontSizes": [
        {
          "slug": "display-xl",
          "size": "clamp(3rem, 5.2vw, 4.5rem)",
          "name": "Display XL"
        },
        {
          "slug": "display",
          "size": "clamp(2.75rem, 4.3vw, 3.75rem)",
          "name": "Display"
        },
        {
          "slug": "h1",
          "size": "clamp(2.5rem, 3.7vw, 3.25rem)",
          "name": "Heading 1"
        },
        {
          "slug": "h2",
          "size": "clamp(2.125rem, 3vw, 2.5rem)",
          "name": "Heading 2"
        },
        {
          "slug": "h3",
          "size": "clamp(1.625rem, 2.2vw, 1.75rem)",
          "name": "Heading 3"
        },
        {
          "slug": "h4",
          "size": "clamp(1.25rem, 1.8vw, 1.375rem)",
          "name": "Heading 4"
        },
        {
          "slug": "body-xl",
          "size": "1.3125rem",
          "name": "Body XL"
        },
        {
          "slug": "body-large",
          "size": "1.125rem",
          "name": "Body Large"
        },
        {
          "slug": "body",
          "size": "1rem",
          "name": "Body"
        },
        {
          "slug": "body-small",
          "size": "0.875rem",
          "name": "Body Small"
        },
        {
          "slug": "label",
          "size": "0.75rem",
          "name": "Label"
        }
      ],
      "fontStyle": false,
      "fontWeight": true,
      "letterSpacing": false,
      "lineHeight": false,
      "textDecoration": true,
      "textTransform": true
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true,
      "radiusSizes": [
        {
          "slug": "sm",
          "size": "8px",
          "name": "Small"
        },
        {
          "slug": "md",
          "size": "14px",
          "name": "Medium"
        },
        {
          "slug": "lg",
          "size": "22px",
          "name": "Large"
        },
        {
          "slug": "xl",
          "size": "28px",
          "name": "Extra Large"
        }
      ]
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        {
          "slug": "subtle",
          "name": "Subtle",
          "shadow": "0 8px 30px rgba(13,17,16,0.06)"
        },
        {
          "slug": "floating",
          "name": "Floating",
          "shadow": "0 16px 50px rgba(13,17,16,0.10)"
        }
      ]
    },
    "dimensions": {
      "aspectRatio": true,
      "minHeight": true
    },
    "position": {
      "sticky": true
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|porcelain",
      "text": "var:preset|color|ink"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|dm-sans",
      "fontSize": "var:preset|font-size|body",
      "fontWeight": "400",
      "lineHeight": "1.6"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|5",
      "padding": {
        "left": "20px",
        "right": "20px"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var:preset|font-family|instrument-sans",
          "fontWeight": "600",
          "lineHeight": "1.1",
          "letterSpacing": "-0.025em"
        },
        "color": {
          "text": "var:preset|color|ink"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|ink"
        },
        "typography": {
          "textDecoration": "none"
        }
      },
      "button": {
        "border": {
          "radius": "12px"
        },
        "color": {
          "background": "var:preset|color|ink-deep",
          "text": "var:preset|color|white"
        },
        "spacing": {
          "padding": {
            "top": "12px",
            "bottom": "12px",
            "left": "22px",
            "right": "22px"
          }
        },
        "typography": {
          "fontFamily": "var:preset|font-family|instrument-sans",
          "fontSize": "var:preset|font-size|body",
          "fontWeight": "600"
        }
      }
    }
  }
}
