{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1180px"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "tan", "name": "Tan", "color": "#C0976F" },
				{ "slug": "champagne", "name": "Champagne", "color": "#D4B896" },
				{ "slug": "brown", "name": "Brown", "color": "#A7795B" },
				{ "slug": "dark", "name": "Dark", "color": "#111111" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "cream", "name": "Cream", "color": "#FAF6F1" }
			]
		},
		"typography": {
			"customFontSize": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif"
				},
				{
					"slug": "serif",
					"name": "Editorial Serif",
					"fontFamily": "Georgia, 'Times New Roman', serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9rem", "name": "Small" },
				{ "slug": "medium", "size": "1.125rem", "name": "Medium" },
				{ "slug": "large", "size": "1.75rem", "name": "Large" },
				{ "slug": "x-large", "size": "2.75rem", "name": "Extra Large" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ]
		}
	},
	"styles": {
		"color": {
			"background": "#FFFFFF",
			"text": "#111111"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)"
		}
	}
}
